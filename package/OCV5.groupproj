<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{D9BA13BE-E37A-46B4-830A-B4ED41B621A6}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="OpenCV5.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="OpenCV5Vcl.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="OpenCV5Fmx.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="..\Test\Project1.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="..\Test\Project2.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="OpenCV5">
        <MSBuild Projects="OpenCV5.dproj"/>
    </Target>
    <Target Name="OpenCV5:Clean">
        <MSBuild Projects="OpenCV5.dproj" Targets="Clean"/>
    </Target>
    <Target Name="OpenCV5:Make">
        <MSBuild Projects="OpenCV5.dproj" Targets="Make"/>
    </Target>
    <Target Name="OpenCV5Vcl">
        <MSBuild Projects="OpenCV5Vcl.dproj"/>
    </Target>
    <Target Name="OpenCV5Vcl:Clean">
        <MSBuild Projects="OpenCV5Vcl.dproj" Targets="Clean"/>
    </Target>
    <Target Name="OpenCV5Vcl:Make">
        <MSBuild Projects="OpenCV5Vcl.dproj" Targets="Make"/>
    </Target>
    <Target Name="OpenCV5Fmx">
        <MSBuild Projects="OpenCV5Fmx.dproj"/>
    </Target>
    <Target Name="OpenCV5Fmx:Clean">
        <MSBuild Projects="OpenCV5Fmx.dproj" Targets="Clean"/>
    </Target>
    <Target Name="OpenCV5Fmx:Make">
        <MSBuild Projects="OpenCV5Fmx.dproj" Targets="Make"/>
    </Target>
    <Target Name="Project1">
        <MSBuild Projects="..\Test\Project1.dproj"/>
    </Target>
    <Target Name="Project1:Clean">
        <MSBuild Projects="..\Test\Project1.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Project1:Make">
        <MSBuild Projects="..\Test\Project1.dproj" Targets="Make"/>
    </Target>
    <Target Name="Project2">
        <MSBuild Projects="..\Test\Project2.dproj"/>
    </Target>
    <Target Name="Project2:Clean">
        <MSBuild Projects="..\Test\Project2.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Project2:Make">
        <MSBuild Projects="..\Test\Project2.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="OpenCV5;OpenCV5Vcl;OpenCV5Fmx;Project1;Project2"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="OpenCV5:Clean;OpenCV5Vcl:Clean;OpenCV5Fmx:Clean;Project1:Clean;Project2:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="OpenCV5:Make;OpenCV5Vcl:Make;OpenCV5Fmx:Make;Project1:Make;Project2:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
